{
  "name": "@bllt/desktop",
  "version": "0.1.0",
  "description": "Bllt: inventario, ventas y clientes en dólares y bolívares",
  "main": "./out/main/index.js",
  "author": "Juan Villarroel <bllt@juanl.dev>",
  "homepage": "https://bllt.juanl.dev",
  "scripts": {
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "svelte-check": "svelte-check --tsconfig ./tsconfig.web.json",
    "typecheck": "pnpm typecheck:node && pnpm svelte-check",
    "db:generate": "drizzle-kit generate",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps && node scripts/brand-electron-dev.mjs",
    "build:unpack": "pnpm build && electron-builder --dir",
    "build:win": "pnpm build && electron-builder --win",
    "build:mac": "pnpm build && electron-builder --mac",
    "build:linux": "pnpm build && electron-builder --linux",
    "test:e2e": "electron-vite build && node e2e/smoke.mjs",
    "seed:demo": "ELECTRON_RUN_AS_NODE=1 electron scripts/seed-demo.mjs"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@bllt/shared": "workspace:*",
    "@bllt/ui": "workspace:*",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@lucide/svelte": "^1.48.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.1",
    "drizzle-kit": "^0.31.11",
    "electron": "^44.4.5",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "mode-watcher": "^1.1.0",
    "playwright-core": "^1.63.0",
    "svelte": "^5.45.6",
    "svelte-check": "^4.3.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  },
  "productName": "Bllt",
  "private": true,
  "license": "Apache-2.0"
}
