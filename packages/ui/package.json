{
  "name": "@bllt/ui",
  "version": "0.1.4",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "svelte": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./src/styles/app.css",
    "./lib/*.js": "./src/lib/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./hooks/*.js": "./src/hooks/*.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./components/*/index.js": {
      "types": "./src/components/*/index.ts",
      "svelte": "./src/components/*/index.ts",
      "default": "./src/components/*/index.ts"
    },
    "./components/*": {
      "types": "./src/components/*/index.ts",
      "svelte": "./src/components/*/index.ts",
      "default": "./src/components/*/index.ts"
    }
  },
  "scripts": {
    "typecheck": "svelte-check --tsconfig ./tsconfig.json"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "dependencies": {
    "@bllt/shared": "workspace:*",
    "@fontsource-variable/montserrat": "5.3.0",
    "@internationalized/date": "3.12.4",
    "@lucide/svelte": "1.48.0",
    "bits-ui": "2.19.3",
    "clsx": "2.1.1",
    "mode-watcher": "1.1.0",
    "svelte-sonner": "1.2.1",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "7.3.6"
  }
}
